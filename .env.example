# Domain name for the site. Caddy gets and renews an HTTPS certificate for it, so
# DNS must point at this server and ports 80 and 443 must be reachable.
# Use a bare port such as :80 instead if another reverse proxy handles HTTPS.
LINEWORK_SITE_ADDRESS=linework.example.com

# Full public URL. Used in /llms.txt links and to restrict collaboration to this site.
LINEWORK_SITE_URL=https://linework.example.com

# Host ports to publish.
HTTP_PORT=80
HTTPS_PORT=443
